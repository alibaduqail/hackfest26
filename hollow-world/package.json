{
  "name": "hollow-living-world",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "harness": "tsx scenarios/tower-down.ts",
    "harness:all": "tsx scenarios/tower-down.ts --all",
    "harness:search": "tsx scenarios/beacon-search.ts",
    "dev": "vite --host 127.0.0.1 --port 4174",
    "start": "vite --host 127.0.0.1 --port 4174",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174",
    "test": "node --import tsx --test src/engine/*.test.ts src/world/*.test.ts src/echo/*.test.ts src/echo-view/*.test.ts src/echo-view/game/*.test.ts src/echo-view/cutaway/*.test.ts",
    "benchmark": "tsx src/engine/benchmark.ts"
  },
  "dependencies": {
    "pixi.js": "^8.23.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
